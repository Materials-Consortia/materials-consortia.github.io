# Links the checker cannot verify, as opposed to links that have rotted.
# Keep this list short, and give a reason for every entry.

# DOIs are persistent identifiers, and doi.org answers unauthenticated
# requests from CI with a Cloudflare 403.
^https?://(dx\.)?doi\.org/

# Slack blocks unauthenticated requests to workspace URLs by design.
^https?://[a-z0-9-]+\.slack\.com/

# Timeanddate rejects bots with 403
^https://www.timeanddate.com/
